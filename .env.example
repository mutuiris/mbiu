# Mbiu settings. Copy to .env and fill in but dont commit it
# Variables starting with NEXT_PUBLIC_ are sent to the browser,
# not in secret there

#  Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

#  Local database (Docker Compose)
# Choose your own password, letters and digits only (it goes inside URLs)
POSTGRES_USER=mbiu
POSTGRES_PASSWORD=
POSTGRES_DB=mbiu

#  Database
# Replace PASSWORD with your POSTGRES_PASSWORD. Inside Docker, Compose builds the API's URL itself.
# Pooled, transaction mode: local PgBouncer, or Supabase Supavisor on port 6543
DATABASE_URL=postgresql://mbiu:PASSWORD@localhost:6432/mbiu
# Migrations and corpus pipeline: local Postgres, or the Supabase session pooler on port 5432
DATABASE_DIRECT_URL=postgresql://mbiu:PASSWORD@localhost:5432/mbiu

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
FAILOVER_ENABLED=false

# Embeddings
EMBEDDING_MODEL_ID=google/embeddinggemma-2
EMBEDDING_REVISION=
EMBEDDING_DIM=768

#  Upload caps
MAX_UPLOAD_MB=10
MAX_PAGES=40

#  Budgets & Load Tuning (Tuned via MB-30 k6 benchmarks at 40-page cap)
# Number of clauses sent per LLM batch. Tuned to 6: balances prompt overhead with token limits.
BATCH_SIZE=6
# Maximum concurrent model requests. Tuned to 4: prevents connection saturation & provider rate limits.
LLM_CONCURRENCY=4
# Maximum token spend per contract evaluation. Tuned to 400,000 for 40-page documents with safety margin.
TOKEN_BUDGET_PER_CONTRACT=400000
# Timeout for an individual batch call to Gemini or OpenAI in seconds.
BATCH_TIMEOUT_S=30
# Grace duration added per clause to the overall request deadline in seconds.
DEADLINE_PER_CLAUSE_S=3
# Hard processing deadline cap for the entire contract evaluation stream in seconds (5 minutes).
DEADLINE_CAP_S=300

#  Corpus Configuration & Rollbacks (MB-10 / MB-30)
# Active version identifier for reviewed template benchmarks (flip to previous version on rollback)
ACTIVE_CORPUS_VERSION=synthetic-v0

#  Bot protection
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

#  Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=mbiu-api

# Errors, analytics, feature flags
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
GROWTHBOOK_CLIENT_KEY=

#  Corpus pipeline only
FIRECRAWL_API_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_BUCKET=mbiu-raw-templates
