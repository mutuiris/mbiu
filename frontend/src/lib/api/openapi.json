      "Section": {
        "additionalProperties": false,
        "description": "A part of the contract: the main body, a schedule or an annex.",
        "properties": {
          "kind": {
            "enum": [
              "body",
              "schedule",
              "annex"
            ],
            "title": "Kind",
            "type": "string"
          },
          "section_id": {
            "title": "Section Id",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
