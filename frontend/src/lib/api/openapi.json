          {
            "$ref": "#/components/schemas/ContractMapEvent"
          },
          {
            "$ref": "#/components/schemas/ProgressEvent"
          },
          {
            "$ref": "#/components/schemas/ClauseResultEvent"
          },
          {
            "$ref": "#/components/schemas/ClauseUpdatedEvent"
          },
          {
            "$ref": "#/components/schemas/ClauseFailedEvent"
          },
          {
            "$ref": "#/components/schemas/HeartbeatEvent"
          },
          {
            "$ref": "#/components/schemas/DoneEvent"
          }
        ]
      },
