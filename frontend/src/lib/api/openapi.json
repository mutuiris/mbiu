          "segment",
          "map",
          "retrieve",
          "compare",
          "verify",
          "summarise"
        ],
        "title": "Stage",
        "type": "string"
      },
      "StreamEvent": {
        "discriminator": {
          "mapping": {
            "clause_failed": "#/components/schemas/ClauseFailedEvent",
            "clause_result": "#/components/schemas/ClauseResultEvent",
            "clause_updated": "#/components/schemas/ClauseUpdatedEvent",
            "contract_map": "#/components/schemas/ContractMapEvent",
